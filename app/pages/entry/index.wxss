.entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.entry__seal {
  position: relative;
  /* 印章里的「年猪宴」用 28 格标题字，字号 112rpx（= 28 × 4），印章相应放大 */
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 32%, #e5574a 0%, #d8342a 58%, #a3201a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 44rpx rgba(142, 27, 20, 0.28);
  opacity: 0;
  transform: scale(0.6);
  z-index: 20;
}

.entry__seal.is-in {
  animation: entry-seal 900ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

.entry__ring {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(239, 184, 74, 0.92);
  box-shadow: inset 0 0 24rpx rgba(255, 231, 168, 0.45);
}

.entry__chars {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #ffe7a8;
  font-family: var(--np-font-stamp);
  font-size: 112rpx;
  font-weight: 400;
  /* 点阵字的墨迹是满格高（1em = 112rpx），行高小于它就会上下叠在一起 */
  line-height: 112rpx;
  /* 竖排，不需要横向字距；留着会让每个字箱宽一点、整列微微偏左 */
  letter-spacing: 0;
  text-shadow: 0 4rpx 0 rgba(142, 27, 20, 0.5);
}

.entry__sub {
  margin-top: 54rpx;
  font-size: 28rpx;
  letter-spacing: 6rpx;
  color: #3a2b25;
  opacity: 0;
  z-index: 20;
}

.entry__sub.is-in {
  animation: np-fade-in 700ms 320ms ease-out forwards;
}

.entry__hint {
  position: absolute;
  bottom: calc(96rpx + env(safe-area-inset-bottom));
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: rgba(58, 43, 37, 0.55);
  animation: np-breathe 2.6s ease-in-out infinite;
  z-index: 20;
}

@keyframes entry-seal {
  0% {
    opacity: 0;
    transform: scale(0.6);
  }
  62% {
    opacity: 1;
    transform: scale(1.06);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}
