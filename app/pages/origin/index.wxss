.origin {
  padding: calc(74rpx + env(safe-area-inset-top)) 60rpx 0;
}

.origin__head {
  text-align: center;
}

.origin__title {
  font-family: var(--np-font-title);
  font-size: 56rpx;
  font-weight: 400;
  letter-spacing: 6rpx;
  color: #d8342a;
  text-shadow: 0 2rpx 10rpx rgba(142, 27, 20, 0.12);
}

.origin__badge {
  display: inline-block;
  margin-bottom: 16rpx;
  padding: 6rpx 20rpx;
  border: 3rpx solid rgba(216, 52, 42, 0.5);
  border-radius: 8rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: #a3201a;
}

.origin__fact {
  margin-top: 8rpx;
  padding: 22rpx 26rpx;
  border-left: 6rpx solid rgba(216, 52, 42, 0.5);
  background: rgba(255, 252, 244, 0.7);
  font-size: 28rpx;
  line-height: 1.6;
  color: #8e1b14;
}

.origin__more {
  position: absolute;
  left: 50%;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  padding: 14rpx 34rpx;
  border-radius: 40rpx;
  border: 3rpx solid rgba(184, 134, 43, 0.6);
  background: rgba(255, 252, 244, 0.86);
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: #b8862b;
  z-index: 60;
}

.origin__sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  letter-spacing: 5rpx;
  color: rgba(58, 43, 37, 0.6);
}

.origin__body {
  margin-top: 44rpx;
}

.origin__para {
  display: flex;
  align-items: flex-start;
  margin-bottom: 26rpx;
  font-size: 28rpx;
  line-height: 1.68;
  letter-spacing: 1rpx;
  color: rgba(58, 43, 37, 0.9);
  text-align: justify;
}

.origin__dot {
  flex: none;
  width: 10rpx;
  height: 10rpx;
  margin: 18rpx 18rpx 0 0;
  border-radius: 50%;
  background: rgba(216, 52, 42, 0.5);
}

.origin__foot {
  position: absolute;
  left: 60rpx;
  right: 60rpx;
  bottom: calc(96rpx + env(safe-area-inset-bottom));
  padding-top: 22rpx;
  border-top: 2rpx solid rgba(184, 134, 43, 0.32);
  font-size: 28rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
  color: #b8862b;
  text-align: center;
}

.origin__back {
  position: absolute;
  right: calc(44rpx + env(safe-area-inset-right));
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 38% 32%, #e5574a 0%, #d8342a 60%, #a3201a 100%);
  box-shadow: 0 10rpx 26rpx rgba(142, 27, 20, 0.26);
  z-index: 60;
}

.origin__back-ring {
  position: absolute;
  left: 7rpx;
  top: 7rpx;
  right: 7rpx;
  bottom: 7rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(239, 184, 74, 0.9);
}

.origin__back-label {
  font-family: var(--np-font-title);
  font-size: 56rpx;
  font-weight: 400;
  color: #ffe7a8;
}
