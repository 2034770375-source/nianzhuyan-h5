.fw {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 3;
}

.fw__burst {
  position: absolute;
  border-radius: 50%;
  opacity: 0;
  background: radial-gradient(
    circle,
    rgba(255, 236, 190, 0.62) 0%,
    rgba(255, 196, 120, 0.26) 34%,
    rgba(255, 176, 108, 0.1) 58%,
    rgba(255, 246, 233, 0) 74%
  );
  animation-name: np-firework;
  animation-timing-function: ease-out;
  animation-iteration-count: infinite;
  will-change: transform, opacity;
}

@keyframes np-firework {
  0% {
    transform: scale(0.18);
    opacity: 0;
  }
  16% {
    opacity: 0.18;
  }
  46% {
    transform: scale(1);
    opacity: 0.09;
  }
  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}
