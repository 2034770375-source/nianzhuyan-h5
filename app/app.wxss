/* NP-PIXEL-FONT:BEGIN */
/* 正文点阵字：14 格 Bold，字号取 14 的整数倍。
   —— 由 _tools/gen_pixel_font.py 生成，这两段不要手改；
      文案改了要重跑，否则新字会回落系统字体。 */
@font-face {
  font-family: "NP Pixel";
  src: url("data:font/woff2;charset=utf-8;base64,") format("woff2");
  font-display: block;
}
/* 标题点阵字：28 格 Medium，只给封面金框/长地图标题/入口印章用，字号取 28 的整数倍。
   —— 由 _tools/gen_pixel_font.py 生成，这两段不要手改；
      文案改了要重跑，否则新字会回落系统字体。 */
@font-face {
  font-family: "NP Pixel Title";
  src: url("data:font/woff2;charset=utf-8;base64,") format("woff2");
  font-display: block;
}
/* NP-PIXEL-FONT:END */

/* ---------------------------------------------------------------------------
 * 年猪宴 · 全局样式
 * 色板与《01-产品文档》2.1 节一致
 * ------------------------------------------------------------------------- */
page {
  --np-red: #d8342a;
  --np-red-d: #8e1b14;
  --np-gold: #efb84a;
  --np-gold-l: #ffe7a8;
  --np-cream: #fff6e9;
  --np-ink: #3a2b25;
  --np-orange: #f2814b;
  --np-green: #6fae4a;
  /* 点阵字优先，后面是缺字兜底：字库里没有的字自动回落系统字体，不会出现空白或乱码 */
  --np-font-pixel: "NP Pixel", -apple-system, "PingFang SC", "Source Han Sans SC", "Microsoft YaHei", sans-serif;
  /* 标题与正文现在统一用点阵字（原来标题走宋/楷体） */
  --np-font-title: var(--np-font-pixel);
  /* 「年猪宴」这三个字专用：28 格 Medium，笔画多也不会糊成一坨（14 格 Bold 下「宴」会糊死） */
  --np-font-stamp: "NP Pixel Title", var(--np-font-pixel);
  background: var(--np-cream);
  color: var(--np-ink);
  font-family: var(--np-font-pixel);
  /* 点阵字只有一档字重：禁掉浏览器的合成加粗，免得把像素糊掉 */
  font-synthesis: none;
  height: 100%;
  overflow: hidden;
  -webkit-tap-highlight-color: transparent;
}

view,
image,
text {
  box-sizing: border-box;
}

/* 柔性缓动曲线 */
.ease-soft {
  transition-timing-function: cubic-bezier(0.22, 0.61, 0.36, 1);
}

/* ------------------------------- 页面骨架 ------------------------------- */
.stage {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  background: var(--np-cream);
}

/* 暖光底 */
.warm-backdrop {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(
    circle at 50% 42%,
    rgba(255, 220, 168, 0.4) 0%,
    rgba(255, 238, 212, 0.24) 42%,
    rgba(255, 246, 233, 0) 72%
  );
}

/* 纸纹：全局铺一层颗粒，去掉屏幕的「数码感」 */
.paper {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  opacity: 0.5;
  pointer-events: none;
  z-index: 90;
  background-repeat: repeat;
  background-size: 256rpx 256rpx;
  background-image: url("data:image/png;base64,");
}

/* ------------------------------- 标题文字 ------------------------------- */
.dish-title {
  font-size: 56rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  font-family: var(--np-font-title);
  color: #d8342a;
  text-shadow: 0 2rpx 10rpx rgba(142, 27, 20, 0.12);
}

.dish-subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: #3a2b25;
  opacity: 0.86;
}

/* ------------------------------- 静音按钮 ------------------------------- */
.mute-btn {
  position: absolute;
  top: calc(28rpx + env(safe-area-inset-top));
  right: 28rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  border: 3rpx solid rgba(239, 184, 74, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(142, 27, 20, 0.12);
  z-index: 60;
}

.mute-btn__icon {
  width: 34rpx;
  height: 34rpx;
  position: relative;
}

/* 喇叭：用纯 CSS 画，避免额外图片资源 */
.mute-btn__horn {
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 14rpx;
  height: 14rpx;
  background: #d8342a;
  border-radius: 3rpx;
}

.mute-btn__cone {
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 0;
  height: 0;
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
  border-right: 16rpx solid #d8342a;
}

.mute-btn__wave {
  position: absolute;
  right: -4rpx;
  top: 6rpx;
  width: 14rpx;
  height: 22rpx;
  border: 3rpx solid #d8342a;
  border-left: none;
  border-radius: 0 22rpx 22rpx 0;
  opacity: 0.9;
}

.mute-btn--off .mute-btn__wave {
  display: none;
}

.mute-btn--off::after {
  content: "";
  position: absolute;
  left: 22rpx;
  top: 8rpx;
  width: 30rpx;
  height: 4rpx;
  background: #8e1b14;
  border-radius: 3rpx;
  transform: rotate(45deg);
}

/* ------------------------------- 通用动画 ------------------------------- */
@keyframes np-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

@keyframes np-breathe {
  0%,
  100% {
    opacity: 0.42;
    transform: scale(1);
  }
  50% {
    opacity: 0.92;
    transform: scale(1.06);
  }
}

@keyframes np-fade-in {
  from {
    opacity: 0;
    transform: scale(0.94);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
